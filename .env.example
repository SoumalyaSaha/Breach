# --- LLM providers ---------------------------------------------------------
# Primary: Groq. Keys are tried in order with per-key cooldowns.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-3.2-11b-vision-preview

# Fallback 1: Google AI Studio (free tier)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Fallback 2: local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Set to 1 to force the offline path (no network calls at all)
BREACH_OFFLINE=

# --- behaviour --------------------------------------------------------------
LLM_TIMEOUT=45
BREACH_SESSION_FILE=.breach_session.json
BREACH_OUTPUT_DIR=outputs
BREACH_WEB_PORT=8501
