# --- LLM providers ---------------------------------------------------------
# Bring YOUR OWN key. This project ships with no keys: the maintainer does not
# pay for other people's usage. Any one of these is enough to run Breach.
#
# OpenAI is the simplest option: one key, and the model handles BOTH text and
# images (images are needed for the blackboard's drawing -> LaTeX feature).
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Google AI Studio (free tier). gemini-2.5-flash handles text AND images.
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GOOGLE_MODEL=gemini-2.5-flash

# Groq (free tier, very fast). Text-only on most accounts.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=meta-llama/llama-3.2-11b-vision-preview

# Local Ollama: no key, no cost, no network calls.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Set to 1 to force the offline path (no network calls at all)
BREACH_OFFLINE=

LLM_TIMEOUT=45
BREACH_SESSION_FILE=.breach_session.json
BREACH_OUTPUT_DIR=outputs
BREACH_WEB_PORT=8501
